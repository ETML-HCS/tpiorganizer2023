# Exemple de configuration serveur (à copier dans .env)
# Identifiants admin legacy optionnels. L'interface principale démarre désormais
# une session applicative automatiquement et n'affiche plus de formulaire login.
# Si ces valeurs sont utilisées en dev local, l'API les convertit en mémoire.
AUTH_USER_PLAIN=
AUTH_PASS_PLAIN=

# Variante legacy production ou CI: hashes bcrypt pré-calculés
AUTH_USER_HASH=
AUTH_PASS_HASH=

# Mode démo (true ou false)
REACT_APP_DEBUG=true
REACT_APP_API_URL_TRUE=http://localhost:5001
REACT_APP_API_URL_FALSE=http://localhost:8080

# Active les controles admin dans l'interface React.
# Ne remplace pas les permissions backend.
REACT_APP_ENABLE_ADMIN_UI=false

# Secret legacy utilise par TpiTracker pour chiffrer/dechiffrer les mots de passe.
# Comme il est injecte dans le bundle frontend, il reste visible par le client.
REACT_APP_TPI_TRACKER_SECRET=

# Secret JWT pour les magic links et sessions web
JWT_SECRET=

# Duree de validite des magic links en heures
MAGIC_LINK_VOTE_EXPIRY_HOURS=168
MAGIC_LINK_SOUTENANCE_EXPIRY_HOURS=96

# Envoi email automatique (désactivé côté UI tant que le flux n'est pas validé)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TPI Organizer <noreply@tpi-organizer.ch>
SMTP_FROM_ARBITRAGE=
SMTP_FROM_NAME_ARBITRAGE=
# Domaines autorises pour l'en-tete From automatique. Si vide, le domaine de SMTP_FROM,
# SMTP_ENVELOPE_FROM et SMTP_DKIM_DOMAIN est utilise comme garde-fou.
SMTP_ALLOWED_FROM_DOMAINS=
# Adresse Return-Path/envelope optionnelle. Doit appartenir a un domaine SPF autorise.
SMTP_ENVELOPE_FROM=
# Adresse ou URL optionnelle pour l'en-tete List-Unsubscribe.
# Si vide, l'adresse Reply-To ou l'expediteur est utilise en mailto.
SMTP_LIST_UNSUBSCRIBE_EMAIL=
SMTP_LIST_UNSUBSCRIBE_URL=
# Domaine optionnel pour Message-ID. Par defaut, domaine de l'adresse From effective.
SMTP_MESSAGE_ID_DOMAIN=
# DKIM applicatif optionnel si le fournisseur SMTP ne signe pas deja les messages.
# Preferer la signature DKIM native du fournisseur SMTP quand elle existe.
SMTP_DKIM_DOMAIN=
SMTP_DKIM_SELECTOR=
SMTP_DKIM_PRIVATE_KEY=

# Secret optionnel dédié aux sessions automatiques de l'application
AUTH_SESSION_SECRET=

# Bypass explicite de l'auth planning en local seulement
SKIP_PLANNING_AUTH=false

# Bypass explicite de l'auth admin legacy en local seulement
SKIP_APP_AUTH=false

# URI Mongo optionnelle pour simplifier la configuration locale
DB_URI=

# Sécurité serveur
PORT=8080
CORS_ORIGIN=http://localhost:3000,http://localhost:8080
JSON_BODY_LIMIT=10mb
API_RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10
TPI_EVAL_PDF_PATH=./API/models/mEvalV3.pdf

# Publication statique des défenses
# Racine FTP visible publiquement, par exemple le dossier public_html de l'hébergement.
FTP_HOST=
FTP_PORT=21
FTP_USER=
FTP_PASSWORD=
FTP_REMOTE_DIR=

# Sous-dossier FTP de la publication statique. Laisser vide publie dans soutenances-{year}
# sous FTP_REMOTE_DIR. Peut contenir {year}.
# Pour publier directement dans FTP_REMOTE_DIR, utiliser "." et STATIC_PUBLIC_PATH=/.
FTP_STATIC_REMOTE_DIR=

# URL publique du domaine et chemin public. Laisser STATIC_PUBLIC_PATH vide utilise /soutenances-{year}/.
STATIC_PUBLIC_BASE_URL=https://tpi26.ch
STATIC_PUBLIC_PATH=

# Secret partage entre l'application et le mini-site vote pour synchroniser les réponses.
# Choisir une valeur longue et aleatoire, puis regenerer et republier le mini-site vote.
STATIC_VOTE_SYNC_SECRET=
STATIC_VOTE_AUTO_SYNC=false
STATIC_VOTE_AUTO_SYNC_YEARS=2026

# Optionnel: secret dedie aux liens d'arbitrage du mini-site vote.
# Si vide, STATIC_VOTE_SYNC_SECRET est utilise.
STATIC_VOTE_ARBITRAGE_SECRET=
